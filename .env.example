# ---------------------------------------------------------------------------
# XumariSystem – secrets & environment
# Copy to `.env` and fill in. Never commit the real `.env`.
# ---------------------------------------------------------------------------

# Discord bot token (Developer Portal → Bot → Reset Token)
DISCORD_TOKEN=

# PostgreSQL connection string (docker-compose sets this automatically for its services)
DATABASE_URL=postgresql://xumari:xumari@localhost:5432/xumari

# Used by docker-compose for the bundled PostgreSQL container
POSTGRES_USER=xumari
POSTGRES_PASSWORD=change-me
POSTGRES_DB=xumari

# Path to config.yaml (relative to the project root or absolute)
CONFIG_PATH=bot/config/config.yaml

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
LOG_DIR=logs

# Optional override of `api.mode` in config.yaml: embedded | external | disabled
# API_MODE=embedded

# Host port for the API container (docker-compose)
API_PORT=8080

# --- Stripe (Dashboard → Developers → API keys / Webhooks) -----------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Cloudflare R2 for ticket transcripts (optional) ------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public URL of the bucket (custom domain or r2.dev URL), e.g. https://transcripts.example.com
R2_PUBLIC_BASE_URL=

# --- AI validation of ticket answers (any OpenAI compatible endpoint) -------
AI_API_KEY=
